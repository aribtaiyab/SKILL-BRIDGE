# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://skill-bridge-nine-bice.vercel.app
NEXT_PUBLIC_API_URL=https://skill-bridge-nine-bice.vercel.app/api

# Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_32_chars

# AI Intelligence Layer (Groq API - Server-side only)
# Leave empty to run with authoritative deterministic SkillBridge calculations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Database (Supabase / Postgres)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
