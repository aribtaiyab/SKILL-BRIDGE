# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Render: set this to the deployed Vercel origin. Multiple exact origins may be comma-separated.
FRONTEND_URLS=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Intelligence Layer (Google Gemini API - Server-side only)
# Leave empty to run with authoritative deterministic SkillBridge calculations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
