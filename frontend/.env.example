# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://skill-bridge-nine-bice.vercel.app
NEXT_PUBLIC_API_URL=https://skill-bridge-nine-bice.vercel.app/api

# Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_32_chars

# AI Intelligence Layer (Google Gemini API - Server-side only)
# Leave empty to run with authoritative deterministic SkillBridge calculations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Database (Supabase / Postgres)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
